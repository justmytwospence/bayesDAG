{
  "name": "bayesdag",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "npm run build:widget && npm run build:mathjax && node -e \"require('fs').copyFileSync('js/widget.css','src/bayesdag/static/widget.css')\"",
    "build:widget": "esbuild js/index.js --minify --format=esm --bundle --outfile=src/bayesdag/static/widget.js",
    "build:mathjax": "esbuild js/mathjax_entry.js --bundle --format=iife --platform=browser --define:PACKAGE_VERSION='\"3.2.1\"' --outfile=src/bayesdag/static/mathjax.bundle.js",
    "dev": "esbuild js/index.js --sourcemap=inline --format=esm --bundle --outfile=src/bayesdag/static/widget.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  },
  "dependencies": {
    "d3-selection": "^3",
    "d3-transition": "^3",
    "d3-zoom": "^3",
    "mathjax-full": "^3.2.1"
  }
}
